{
  "name": "homestead-acres",
  "version": "0.7.0",
  "private": true,
  "description": "A single-player farming game in the style of FarmVille 1, for PC and mobile browsers.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "phaser": "^3.90.0",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
